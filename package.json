{
	"name": "alive",
	"version": "0.2.0",
	"private": true,
	"description": "A long-lived agent runtime built on @earendil-works/pi-coding-agent: system prompt -> poll -> tool calls -> outbound messages as tool use -> poll",
	"type": "module",
	"bin": {
		"alive": "./dist/index.js"
	},
	"engines": {
		"node": ">=22.5"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"init": "tsx src/index.ts init",
		"run": "tsx src/index.ts run",
		"status": "tsx src/index.ts status",
		"modules": "tsx src/index.ts modules",
		"history": "tsx src/index.ts history",
		"browser:fortress": "tsx src/fortress.ts",
		"test:browser": "tsx src/dev/browser-test.ts",
		"test:browser:access": "tsx src/dev/browser-access-test.ts",
		"test:browser:access:e2e": "tsx src/dev/browser-access-e2e-test.ts",
		"test:browser:content:e2e": "tsx src/dev/browser-content-e2e-test.ts",
		"test:browser:native:e2e": "tsx src/dev/browser-native-e2e-test.ts",
		"test:browser:fortress:e2e": "tsx src/dev/browser-fortress-e2e-test.ts",
		"test:browser:oss": "tsx src/dev/browser-oss-test.ts",
		"browser": "tsx src/index.ts browser",
		"telegram": "tsx src/index.ts telegram",
		"smoke": "tsx src/dev/smoke.ts",
		"test": "tsc -p tsconfig.json --noEmit && tsx src/dev/sandbox-test.ts && tsx src/dev/onboarding-test.ts && tsx src/dev/agent-lifecycle-test.ts && tsx src/dev/agent-messaging-test.ts && tsx src/dev/agent-tui-test.ts && tsx src/dev/memory-test.ts && tsx src/dev/store-test.ts && tsx src/dev/idle-test.ts && tsx src/dev/runner-test.ts && tsx src/dev/worker-test.ts && tsx src/dev/modules-test.ts && tsx src/dev/daemon-test.ts && tsx src/dev/update-test.ts && tsx src/dev/browser-test.ts && tsx src/dev/browser-access-test.ts && tsx src/dev/browser-live-test.ts && tsx src/dev/browser-router-test.ts && tsx src/dev/browser-router-capacity-test.ts && tsx src/dev/browser-identity-worker-test.ts && tsx src/dev/browser-operator-test.ts && tsx src/dev/browser-oss-test.ts && tsx src/dev/browser-shared-test.ts && tsx src/dev/fortress-browser-test.ts",
		"alive": "tsx src/index.ts",
		"test:sandbox": "tsx src/dev/sandbox-test.ts",
		"test:sandbox:vm": "tsx src/dev/sandbox-vm-test.ts",
		"test:store": "tsx src/dev/store-test.ts",
		"test:memory": "tsx src/dev/memory-test.ts",
		"test:idle": "tsx src/dev/idle-test.ts",
		"test:runner": "tsx src/dev/runner-test.ts",
		"test:workers": "tsx src/dev/worker-test.ts",
		"test:modules": "tsx src/dev/modules-test.ts",
		"test:daemon": "tsx src/dev/daemon-test.ts",
		"test:update": "tsx src/dev/update-test.ts",
		"test:browser:live": "tsx src/dev/browser-live-test.ts",
		"test:browser:router": "tsx src/dev/browser-router-test.ts",
		"test:browser:router:e2e": "tsx src/dev/browser-router-e2e-test.ts",
		"test:browser:shared": "tsx src/dev/browser-shared-test.ts",
		"test:browser:shared:e2e": "tsx src/dev/browser-shared-e2e-test.ts",
		"test:browser:shared:cli": "tsx src/dev/browser-shared-cli-test.ts",
		"test:browser:e2e": "tsx src/dev/browser-e2e-test.ts",
		"test:browser:tabs:e2e": "tsx src/dev/browser-tabs-e2e-test.ts",
		"test:browser:cdp": "tsx src/dev/browser-cdp-e2e-test.ts",
		"test:browser:operator": "tsx src/dev/browser-operator-test.ts",
		"test:browser:signing": "tsx src/dev/browser-signing-e2e-test.ts",
		"test:browser:cli": "tsx src/dev/browser-cli-e2e-test.ts",
		"test:browser:identity-worker": "tsx src/dev/browser-identity-worker-test.ts",
		"browser:agent": "tsx src/browser.ts",
		"test:fortress": "tsx src/dev/fortress-browser-test.ts",
		"test:browser:shared:signing": "tsx src/dev/browser-shared-signing-test.ts",
		"test:browser:agent:e2e": "tsx src/dev/browser-agent-e2e-test.ts"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.85.1",
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"agent-browser": "0.27.0",
		"microsandbox": "0.7.8",
		"tilion-fortress": "151.0.7910",
		"typebox": "1.3.7",
		"patchright": "1.63.0",
		"pdfjs-dist": "4.10.38",
		"playwright": "1.63.0",
		"ws": "8.22.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.3",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"@types/ws": "8.18.2"
	}
}
